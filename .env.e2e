# .env.e2e — LOCAL end-to-end test environment.
#
# COMMITTED ON PURPOSE. Every value here is a dummy that mirrors the `env:`
# block of the `e2e` job in .github/workflows/ci.yml. NOTHING HERE IS A SECRET,
# and every placeholder token is already allowlisted in .gitleaks.toml.
#
# Loaded by scripts/with-e2e-env.sh via `set -a; . ./.env.e2e; set +a`, i.e.
# exported into the real process environment BEFORE next/prisma boot. Real
# process env always outranks .env / .env.local:
#   - @next/env : only assigns when the key is absent from its process.env snapshot
#   - dotenv    : never overrides an existing key
# So this NEVER clobbers your .env or .env.local — it just wins for the
# lifetime of the e2e run.
#
# NOT named .env.test: Next's loadEnvConfig auto-loads that file when
# NODE_ENV === 'test', which would leak these values into vitest.
#
# Host ports are offset from docker-compose.dev.yml so the dev stack can stay
# up. See docker-compose.e2e.yml.

# ── Backing services (docker-compose.e2e.yml) ────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/lms_e2e?schema=public
REDIS_URL=redis://localhost:6389

# ── App origin ───────────────────────────────────────────────────────────────
# CRITICAL: .env pins AUTH_URL=http://localhost:3000 and NextAuth v5 prefers
# AUTH_URL over NEXTAUTH_URL. Without this override every post-login redirect
# lands on :3000 and the whole suite dies. It is ALSO what keeps the rate-limit
# bypass alive under `next start`: src/lib/rate-limit.ts reads
# AUTH_URL || NEXTAUTH_URL || APP_URL and requires a localhost origin, because
# `next start` forces NODE_ENV=production.
AUTH_URL=http://localhost:3005
NEXTAUTH_URL=http://localhost:3005
APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=ci-build-secret-not-used-in-production
AUTH_SECRET=ci-build-secret-not-used-in-production
AUTH_MICROSOFT_ENTRA_ID_ID=ci-dummy-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=ci-dummy-client-secret
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=ci-dummy-tenant-id

# ── Rate limiting ────────────────────────────────────────────────────────────
# Double-guarded in src/lib/rate-limit.ts: needs this flag AND a non-production
# NODE_ENV or a localhost AUTH_URL (see above).
E2E_TEST_BYPASS_RATE_LIMIT=true

# ── Stripe (dummy; the sk_test_ prefix is required by the SDK's validation) ──
STRIPE_SECRET_KEY=sk_test_ci_dummy_key_not_real_000000000000
STRIPE_WEBHOOK_SECRET=whsec_ci_dummy_not_real
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_ci_dummy_not_real

# ── Mail → MailHog ───────────────────────────────────────────────────────────
# src/lib/email.ts skips SMTP AUTH/STARTTLS for loopback hosts, so plain 1125
# delivers even under the production build. MAILHOG_URL is read by the specs.
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USER=ci@example.com
SMTP_PASSWORD=ci_dummy_password
MAILHOG_URL=http://localhost:8125

# ── Object storage → MinIO ───────────────────────────────────────────────────
# GCS is unconfigured locally, so the app falls back to MinIO. Without this,
# every storage-touching flow (certificate PDF on attestation, document
# uploads) dies with ECONNREFUSED. The bucket is auto-created by
# MinIOProvider.ensureBucket().
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lms_minio_e2e
MINIO_SECRET_KEY=lms_minio_secret_e2e
MINIO_BUCKET=lms-documents

# ── Vertex AI ────────────────────────────────────────────────────────────────
# Required by src/lib/env.ts; ai-client.ts has no default (the old default
# named the PRODUCTION project). Calls still fail at auth — which is exactly
# what the AI-degradation specs assert against.
GOOGLE_PROJECT_ID=ci-dummy-project-not-real
