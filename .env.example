# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Authentication ──────────────────────────────────────────────────────────
# Generate secrets: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# Microsoft Entra ID (Azure AD) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# System admin default password
SYSTEM_ADMIN_PASSWORD=

# ── Inactivity Timeout ─────────────────────────────────────────────────────
# Number of minutes of inactivity before a user is automatically logged out.
# Default: 60 minutes. Minimum: 5, Maximum: 120.
INACTIVITY_TIMEOUT_MINUTES=60

# ── Session revalidation cache (auth) ──────────────────────────────────────
# The JWT decode re-validates the session against the DB on every authenticated
# request (to catch role changes, org removal, deletion, and password-reset
# session invalidation). This caches that revalidation in Redis for a short
# window so repeated requests skip the DB read.
#
# TRADE-OFF: a cache hit lets a revocation lag by up to this many seconds. The
# default (30) is a deliberate, bounded window. Set to 0 to DISABLE the cache
# entirely (always read from the DB) if revocation must be instant.
AUTH_REVALIDATE_TTL_SECONDS=30

# ── Database (Prisma / PostgreSQL) ──────────────────────────────────────────
# In production, DATABASE_URL MUST be a POOLED connection string (e.g. PgBouncer
# in transaction mode, or your provider's pooled endpoint). Append the pooler's
# own connection cap, e.g. ?pgbouncer=true&connection_limit=10, so the app never
# opens more server connections than the pooler allows.
# NOTE: Prisma migrations (migrate deploy/dev) must run against a DIRECT,
# UNPOOLED URL — PgBouncer's transaction pooling breaks DDL. That direct URL is
# configured in the Prisma schema's datasource (directUrl), not here.
DATABASE_URL="postgresql://user:password@localhost:5432/lms?schema=public"
# Max connections the app's pool may open (see db/index.ts). Keep it at or below
# your pooler/Postgres connection cap, divided across app instances. Default: 10.
DATABASE_POOL_MAX=10

# ── Redis (Rate Limiting + BullMQ) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Course-video encoding profile (transcode worker) ───────────────────────
# Tunes the ffmpeg normalization encode in scripts/transcode-worker.ts. These
# affect NEW UPLOADS ONLY — already-transcoded videos keep whatever profile they
# were encoded with until a backfill re-encodes them. Each value is validated;
# anything malformed is ignored (a WARN is logged) and the default is used.
#
# Output width cap in pixels — even integer, 160-3840. Sources narrower than
# this are never upscaled. The learn page renders the player inside 760-860px, so
# 1280 covers 2x-DPR displays; raising it only helps 4K fullscreen, at the cost
# of roughly quadratic growth in file size and bandwidth.
VIDEO_MAX_WIDTH=1280
# Output height cap in pixels — even integer, 90-2160. Sources shorter than this
# are never upscaled. Exists so the declared H.264 level stays honest for
# PORTRAIT and 4:3 uploads, which a width cap alone leaves far above what level
# 3.1 permits. Raise both this and the width together, or the aspect box shrinks
# in only one direction.
VIDEO_MAX_HEIGHT=720
# Output frame-rate cap — integer 10-120. Applied only when the SOURCE is faster
# (a 24fps source is never interpolated up). 60fps sources doubled the decode
# cost on low-end phones for no training benefit. 1280x720 at 30fps is also
# exactly what H.264 level 3.1 allows, so raising this past 30 without lowering
# the resolution caps would make the declared level a lie.
VIDEO_MAX_FPS=30
# libx264 quality target — integer 0-51, lower is better quality/larger file.
# 23 is the libx264 default and is visually transparent for screen-capture and
# talking-head training footage; drop to ~20 only if artefacts are reported.
VIDEO_CRF=23
# Bitrate ceiling for constrained VBR, in the ffmpeg kilobit form "<digits>k"
# (100k-20000k). The VBV buffer is derived as 2x this value. Caps high-motion
# spikes so a modest connection never stalls; raise it if quality is the
# complaint, lower it if buffering is.
VIDEO_MAXRATE=2500k
# libx264 speed/compression trade-off. One of: ultrafast, superfast, veryfast,
# faster, fast, medium, slow, slower, veryslow, placebo. Slower presets produce
# smaller files for the same quality but occupy the shared 2-vCPU container for
# longer, so do not go past "medium" while encodes run alongside the web app.
VIDEO_PRESET=fast

# ── Video playback caching (proxy hot path) ────────────────────────────────
# A <video> element issues one Range request per buffer window plus several per
# seek, so a single playback hits /api/video/[lessonId] dozens of times. These
# knobs control how much of that work is memoised. All caches are IN-PROCESS
# (the app runs as one container per environment); nothing is stored in Redis.
#
# TTL in seconds for the lesson/course metadata cache. The enrollment ALLOW
# cache (300s) and the signed-URL cache derive their own TTLs but are gated by
# this same switch: 0 disables ALL THREE, restoring the uncached behavior with
# no rebuild. Only an ALLOW is ever cached, never a DENY, so a newly-enrolled
# learner is never stuck on a stale 403; the cost is that an unenrollment can
# lag up to 300s (an explicit eviction on removeWorkerAssignment closes that).
VIDEO_PLAYBACK_CACHE_TTL_SECONDS=60
# Expiry requested when minting a storage signed URL, in seconds (clamped to
# 60-604800). These URLs are resolved server-side and the bytes are streamed
# back through the proxy — the browser NEVER receives one — so a long window
# carries no exposure. The signed-URL cache reuses a minted URL for two thirds
# of this value, leaving a third as headroom.
VIDEO_SIGNED_URL_TTL_SECONDS=3600
# Browser cache lifetime for proxied video bytes, in seconds. Responses go out
# as `private, max-age=<N>` + `Vary: Cookie`: `private` permits storage only in
# a single-user cache, which is correct here (nginx has no proxy_cache and
# Cloudflare fronts this as a tunnel, not a caching edge). Setting this
# OVERRIDES both routes' defaults (900 for lesson video, 3600 for the global
# catalog's preview video); 0 emits `private, no-store` and no Vary, i.e. the
# pre-caching behavior. Trade: after an unenrollment, bytes already in that
# learner's own browser cache stay playable locally for up to this long.
VIDEO_CACHE_MAX_AGE_SECONDS=900
# Browser cache lifetime for proxied poster images, in seconds. Served as
# `private, max-age=<N>, immutable` + `Vary: Cookie`. `immutable` is honest
# here: poster objects are content-addressed (system/videos/posters/<ts>-<uuid>)
# and never rewritten in place — a re-encode writes a NEW key. The seam is that
# the route path is stable while the object behind it is not, so a viewer keeps
# seeing the previous still for up to this long after a re-transcode. 0 emits
# `private, no-store`.
VIDEO_POSTER_MAX_AGE_SECONDS=86400

# ── Orphaned-video-object sweeper (BullMQ cron) ─────────────────────────────
# Reconciles the system/videos/ storage prefix against the database and deletes
# objects that nothing references.
#
# OPT-IN + PRODUCTION-ONLY: the sweeper is DISABLED unless this is EXACTLY the
# string "true". Enable it in production ONLY. It deletes storage objects, and
# running it in a non-prod environment that holds prod storage credentials WILL
# delete production videos (this has happened — prod videos were lost twice).
# Leave unset/false everywhere except the single environment that owns the data.
#
# The environment you enable this in MUST be the ONLY one holding WRITE
# credentials for that storage bucket. Every guardrail below is a code-level
# backstop; none of them can protect a bucket that a second environment can
# already delete from. Give non-owning environments their own bucket, or
# read-only credentials, or none at all.
VIDEO_SWEEP_ENABLED=false
# ENVIRONMENT-OWNERSHIP INTERLOCK — set this to the APP_URL of the single
# environment that owns the bucket above. The sweeper refuses to start unless
# this EXACTLY equals APP_URL, and refuses if it is unset while ENABLED is true.
#
# Why this exists: every other flag here lives in the same env file, so copying
# production's .env to staging copies the arming flags along with the production
# bucket and credentials. APP_URL is the one value that MUST change on such a
# copy (or auth redirects and emailed links break), so pinning the owner here
# turns any copied env into a mismatch — and a mismatch refuses to sweep.
# Example (production): VIDEO_SWEEP_OWNER_APP_URL=https://training.theraptly.com
VIDEO_SWEEP_OWNER_APP_URL=
# Objects newer than this are skipped (protects in-flight uploads + transcodes).
# MUST comfortably exceed worst-case transcode time — keep at 24h unless sure.
VIDEO_SWEEP_GRACE_PERIOD_HOURS=24
# Cron pattern for how often the sweep runs (default: every 6 hours).
VIDEO_SWEEP_CRON=0 */6 * * *
# Safety cap: a real (non-dry-run) sweep that would delete MORE than this many
# objects aborts entirely and deletes nothing. Default 10.
VIDEO_SWEEP_MAX_DELETES=10
# Log what WOULD be deleted but delete nothing. FAIL-SAFE DEFAULT: dry-run is ON
# unless this is EXACTLY the string "false" — an omitted or misspelled value
# keeps the sweep harmless rather than destructive. Real deletion is an explicit
# opt-out, never an accident. Leave it dry until a real run's logged scope has
# been reviewed; the worker logs a WARN at boot whenever live deletes are armed.
VIDEO_SWEEP_DRY_RUN=true

# ── Reminders & escalations sweeper (BullMQ cron) ───────────────────────────
# Runs the daily deadline reminder/escalation ladder + Track B (failing/locked
# quiz) nudges over active enrollments. Set ENABLED=false to turn it off entirely.
REMINDER_SWEEP_ENABLED=true
# Cron pattern for how often the sweep runs (default: daily at 08:00).
REMINDER_SWEEP_CRON=0 8 * * *
# When true, log intended sends and perform zero writes. Defaults to false.
REMINDER_SWEEP_DRY_RUN=false
# Days behind "today" a stage may still fire, covering a missed cron day.
REMINDER_CATCHUP_DAYS=2
# Minimum days between recurring Track B nudges of the same kind.
REMINDER_NUDGE_INTERVAL_DAYS=3

# ── Notification digest (BullMQ cron) ──────────────────────────────────────
# Sends the batched (Tier 2) notification summary — one email per organization
# per period, daily or weekly per the org's notificationDigestFrequency setting
# (weekly digests go out on Mondays, UTC). Set ENABLED=false to turn it off.
NOTIFICATION_DIGEST_ENABLED=true
# Cron pattern for how often the digest runs (default: daily at 13:00 UTC,
# ~08:00 US Eastern).
NOTIFICATION_DIGEST_CRON=0 13 * * *
# When true, log intended sends and perform zero writes. Defaults to false.
NOTIFICATION_DIGEST_DRY_RUN=false

# ── Data retention / disposal purge (F-054) ─────────────────────────────────
# Runs at the start of the daily reminder sweep (skipped under dry-run). Deletes
# expired/stale rows on HIPAA-sensible windows. NOTE: audit logs are NEVER
# purged (retained >= 6 years). Set ENABLED=false to turn the purge off.
RETENTION_PURGE_ENABLED=true
# Days after a verification token's `expires` before it is purged (holds
# pending-signup data incl. hashed passwords — kept short).
RETENTION_VERIFICATION_TOKEN_GRACE_DAYS=1
# Age (days) at which terminal (accepted/expired) invites are purged.
RETENTION_INVITE_DAYS=30
# Age (days) at which terminal (completed/failed) jobs are purged.
RETENTION_JOB_DAYS=90
# Age (days) at which successfully-sent email delivery records are purged.
RETENTION_EMAIL_DAYS=90

# ── Enrollment batching (kill-switch, Tier 3 §5.3 PR-7) ─────────────────────
# Course assignment (enrollUsers / assignCourseToRole) enrolls staff one at a
# time — ~6 serial DB queries plus a blocking email per user. With this flag set
# to 'true' the batched path collapses the per-user reads into a few look-ups and
# runs the side-effects with bounded concurrency instead.
#
# Behaviour is identical either way (same seat-limit enforcement, same users
# enrolled/invited, same one-email-per-new-enrollment, same result shape) — the
# flag chooses only the implementation. Defaults OFF (the proven sequential path)
# so production keeps current behaviour until this is explicitly validated and
# flipped on; set back to any non-'true' value for an instant fallback.
# One documented exception: on a HARD mid-batch failure (e.g. the notification
# service throwing), the batched path lets already-in-flight enrollments commit
# before the call rejects, whereas the sequential path stops at the failing entry.
# Neither double-enrolls nor double-emails, and a retry converges (enrollment is
# idempotent) — but which entries are committed on a hard abort differs. Bounded
# concurrency can't fully avoid this without a transaction (which would break the
# existing non-rollback contract). Accepted tradeoff; keep in mind before enabling.
ENROLLMENT_BATCH_ENABLED=false

# ── Google Cloud / Vertex AI ────────────────────────────────────────────────
# REQUIRED, per environment, and deliberately has NO default. It previously fell
# back to the production project, so any environment that left it unset sent its
# Vertex traffic to production while looking correctly configured — credentials
# come from Application Default Credentials (the host's service account), so no
# env file revealed the crossing. Boot now fails without it (src/lib/env.ts) and
# so does any Vertex call (src/lib/ai-client.ts).
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1

# ── Telemetry / log shipping ────────────────────────────────────────────────
# Stamped onto every structured log line as `service`, and reported by the OTel
# collector as service.name. Without it, app logs in Cloud Logging are
# attributable only to an opaque container id — the collector tails Docker's log
# files and those paths carry no service name.
#
# Set by docker-compose for staging/production (lms-staging / lms-production);
# leave unset locally unless you are testing the shipping pipeline.
OTEL_SERVICE_NAME=
#
# The collector authenticates with a PER-ENVIRONMENT service-account key placed
# on the VM at /home/deploy/secrets/otel-sa-<env>.json (mode 0400, never in git)
# and mounted read-only. Do NOT reuse one key across environments: a staging
# credential able to write production telemetry repeats the mistake behind two
# production data-loss incidents. See infra/gcp/README.md.
#
# Minimum level the structured logger emits (src/lib/logger.ts): debug | info |
# warn | error. Defaults to `info` when unset — NODE_ENV does not affect it.
#
# Keep deployed environments at `info`. Every line the logger emits is tailed
# into Cloud Logging and held for the bucket's retention (400 days), so `debug`
# is an ongoing ingestion cost plus long-lived retention of verbose internals
# such as proxy auth context. Raise it deliberately and temporarily when
# debugging, then put it back.
LOG_LEVEL=info

# REMOVED — do not reintroduce.
#
# GEMINI_API_KEY authenticated the *consumer* Gemini surface
# (generativelanguage.googleapis.com), which is NOT covered by the Google Cloud
# BAA. All AI calls go through src/lib/ai-client.ts, which uses an OAuth service
# account against the BAA-covered Vertex AI endpoint and needs no API key —
# GOOGLE_PROJECT_ID plus GCS_KEY_BASE64/ADC is the whole story.
#
# The only consumer of this variable was scripts/test-indexer.ts, which POSTed
# extracted document text to the non-BAA endpoint; it now uses
# generateBatchEmbeddings instead. eslint.config.mjs fails the build on any
# reintroduction of that host or SDK.
#
# Historical note: a NEXT_PUBLIC_GEMINI_API_KEY was previously baked into Docker
# image layers (F-008). Those layers still exist — the key must be rotated in
# GCP if it has not been. See docs/deployment.md §2.1.

# v4.6 course generation wall-clock timeout (ms). Bounds the whole background
# pipeline so a stuck stage can't leave a job in `processing` forever.
# Server-side. Default: 600000 (10 min).
V46_GENERATION_TIMEOUT_MS=600000
# Client-side poll backstop (ms) for the generation UI. Keep slightly ABOVE
# V46_GENERATION_TIMEOUT_MS so the server normally settles the job first.
# Default: 660000 (11 min).
NEXT_PUBLIC_V46_GENERATION_TIMEOUT_MS=660000

# ── Storage: GCS (primary) + MinIO (fallback) ──────────────────────────────
GCP_BUCKET_NAME=
# Service-account key for GCS auth (staging and production only).
# On production/staging, the VM is not a GCP host so ADC cannot auto-resolve.
# Encode the downloaded JSON key:  base64 -w0 key.json
# Leave UNSET in local dev — use:  gcloud auth application-default login
GCS_KEY_BASE64=

# MinIO — always available via Docker (see docker-compose.dev.yml).
# In dev: use localhost. In Docker Compose (staging/prod): use service name "minio".
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lms_minio_dev
MINIO_SECRET_KEY=lms_minio_secret_dev
MINIO_BUCKET=lms-documents

# ── Stripe (Billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_STARTER_QUARTERLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_GROWTH_QUARTERLY_PRICE_ID=
STRIPE_GROWTH_YEARLY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_QUARTERLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# ── Email (SMTP / Zoho) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
# Inbox that receives /partners program applications (defaults to SMTP_USER if unset).
PARTNER_INBOX=

# ── PHI Scanner ────────────────────────────────────────────────────────────
# DEPRECATED (THER-003): PHI detection is now always fail-closed — documents with
# detected PHI (or an unverifiable scan) are always blocked regardless of this var.
# Kept only to avoid breaking existing deploy configs; the code no longer reads it.
# PHI_FAIL_CLOSED=false

# ── Enterprise ──────────────────────────────────────────────────────────────
ENTERPRISE_CONTACT_EMAIL=

# ── Help Center ─────────────────────────────────────────────────────────────
# Support address surfaced as the mailto: link on the Help Center pages
# (/dashboard/help and /worker/help). Inlined into the browser bundle.
# Falls back to support@theraptly.com when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@theraptly.com

# ── hCaptcha bot verification (F-023) ────────────────────────────────────────
# OPTIONAL. The feature is fully inert until enabled: leave these blank and no
# captcha widget renders and no server-side verification runs (public flows are
# unchanged). To turn it on, set HCAPTCHA_ENABLED=true AND provide the secret key,
# and set NEXT_PUBLIC_HCAPTCHA_ENABLED=true AND provide the public site key.
# Get keys at https://dashboard.hcaptcha.com/. Test keys are documented at
# https://docs.hcaptcha.com/#integration-testing-test-keys.
# Server-side (never exposed to the browser):
HCAPTCHA_ENABLED=
HCAPTCHA_SECRET_KEY=
# Client-side (inlined into the browser bundle):
NEXT_PUBLIC_HCAPTCHA_ENABLED=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
