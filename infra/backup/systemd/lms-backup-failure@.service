[Unit]
Description=Announce an LMS backup failure (%i)

[Service]
Type=oneshot
User=deploy
# Emits an ERROR line that the OTel collector's filelog receiver does NOT see —
# it tails Docker container logs, not the host journal. So this is deliberately
# ALSO written where a container can pick it up, and the `_last_success`
# heartbeat object in the bucket remains the authoritative external signal.
#
# Once item 10's monitoring is applied, add an alert on the heartbeat's age.
# Checking freshness from outside the VM is the point: a host that has died
# cannot tell you its backup failed.
ExecStart=/usr/bin/logger -p daemon.err -t lms-backup "CRITICAL: LMS backup failed for %i — see: journalctl -u lms-backup@%i.service"
ExecStart=/bin/sh -c 'echo "[lms-backup][%i] CRITICAL: backup run failed" >&2'
