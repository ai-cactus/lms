{
  "name": "lms2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "next build",
    "start": "node --max-old-space-size=4096 --expose-gc node_modules/.bin/next start",
    "lint": "eslint src/ scripts/ tests/",
    "lint:fix": "eslint src/ scripts/ tests/ --fix",
    "format": "prettier --write \"{src,scripts,tests}/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed ${VERIFY_BASE:-origin/dev} --passWithNoTests",
    "verify": "sh scripts/verify-light.sh",
    "verify:full": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "test:e2e": "sh scripts/with-e2e-env.sh npx playwright test",
    "e2e:local": "sh scripts/e2e-local.sh",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait db redis minio mailhog",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans",
    "e2e:bucket": "docker compose -f docker-compose.e2e.yml --profile init run --rm --no-deps mc-init",
    "secrets:scan": "sh scripts/secrets-scan.sh",
    "secrets:scan:all": "gitleaks dir . --config .gitleaks.toml --redact --no-banner",
    "script": "tsx scripts/run.ts",
    "prepare": "husky",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "find-my-way": "^9.7.0",
    "postcss": "^8.5.12",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.8",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "deepmerge-ts": "^8.0.1",
    "quill": "2.0.2",
    "mysql2": "^3.24.3"
  },
  "lint-staged": {
    "{src,scripts,tests}/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --fix --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "{src,scripts,tests}/**/*.{css,json}": [
      "prettier --write"
    ],
    "prisma/**/*.prisma": [
      "prisma format"
    ]
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@vercel/otel": "^2.1.3",
    "bullmq": "^5.71.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.33.0",
    "google-auth-library": "^10.6.2",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.22.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "minio": "^8.0.7",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "otpauth": "^9.5.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "posthog-js": "^1.417.1",
    "posthog-node": "^5.49.1",
    "qrcode": "^1.5.4",
    "quill": "2.0.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-pdf": "^10.5.0",
    "react-quill-new": "^3.8.3",
    "react-timekeeper": "^2.2.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bcryptjs": "^3.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.3.2",
    "next-auth": "^5.0.0-beta.30",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
