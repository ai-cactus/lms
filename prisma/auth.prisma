// ── Authentication & User Management ──────────────────────────────────────────

enum UserRole {
  owner
  // Full-access org administrator (Owner-equivalent CRUD incl. billing) per the
  // RBAC matrix. Distinct from the retired legacy `admin` — the session guard
  // that rejected legacy-admin tokens was removed in the multi-org auth rework.
  admin
  supervisor
  hr
  clinical_director
  finance
  psychiatrist_prescriber
  nurse
  therapist_clinician
  case_manager
  behavioral_health_technician
  peer_support_specialist
  front_desk_admin
  facilities_support
}

enum InviteStatus {
  pending
  accepted
  expired
}

/// Global identity — one row per person, ever. No organization/role/facility/
/// login-context data lives here; see OrganizationUser for per-membership state.
model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String
  passwordResetRequired Boolean   @default(false) @map("password_reset_required")
  authProvider          String    @default("credentials") @map("auth_provider")
  emailVerified         Boolean   @default(false) @map("email_verified")
  mfaEnabled            Boolean   @default(false) @map("mfa_enabled")
  mfaVerifiedAt         DateTime? @map("mfa_verified_at")
  sessionVersion        Int       @default(0) @map("session_version")

  firstName             String? @map("first_name")
  lastName              String? @map("last_name")
  fullName              String? @map("full_name")
  avatarUrl             String? @map("avatar_url")
  hasSeenAuditorWelcome Boolean @default(false) @map("has_seen_auditor_welcome")

  // Best-effort UX cache only — NOT authoritative membership data. Lets a
  // returning multi-org user skip the org picker; falls back to the picker if
  // the referenced org is stale/gone.
  lastActiveOrganizationId String? @map("last_active_organization_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationMemberships OrganizationUser[]
  mfaFactors              MfaFactor[]
  mfaRecoveryCodes        MfaRecoveryCode[]

  @@map("users")
}

model Invite {
  id                String                   @id @default(uuid())
  email             String
  token             String                   @unique
  organizationId    String                   @map("organization_id")
  role              UserRole
  // Required — every invite targets a specific facility, replacing the
  // "first facility of org" fallback that becomes ambiguous once an org has
  // more than one facility. Cascade: an invite to a deleted facility is
  // meaningless.
  facilityId        String                   @map("facility_id")
  status            InviteStatus             @default(pending)
  expiresAt         DateTime                 @map("expires_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  invitedBy         String?                  @map("invited_by")
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility          Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  courseAssignments InviteCourseAssignment[]

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@index([facilityId])
  @@map("invites")
}

model VerificationToken {
  identifier String
  token      String
  type       String   @default("password_reset")
  expires    DateTime
  password   String?
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  role       String?

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MfaFactor {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @default("totp")
  secret    String?
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}
