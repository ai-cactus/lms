// ── Document Management ──────────────────────────────────────────────────────

model Document {
  id                 String            @id @default(uuid())
  organizationUserId String            @map("organization_user_id")
  filename           String
  originalName       String            @map("original_name")
  mimeType           String            @map("mime_type")
  size               Int
  /// Free-form classification chosen at upload (e.g. "Policy", "Training Manual").
  /// Null for documents uploaded before categories existed, and for uploads that
  /// omit one.
  category           String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  organizationUser   OrganizationUser  @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  versions           DocumentVersion[]

  @@index([organizationUserId])
  @@index([category])
  @@map("documents")
}

/// Org-scoped classification vocabulary for the Document Hub.
///
/// Every organization is seeded with the default list at onboarding and can add
/// its own from the upload modal. `Document.category` stays a free-form string
/// (it is a snapshot of the name chosen at upload), so renaming or removing a
/// category here never rewrites history.
model DocumentCategory {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("document_categories")
}

model DocumentVersion {
  id             String            @id @default(uuid())
  documentId     String            @map("document_id")
  version        Int               @default(1)
  storagePath    String            @map("storage_path")
  hash           String
  content        String?
  createdAt      DateTime          @default(now()) @map("created_at")
  courseVersions CourseVersion[]
  document       Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  mapping        MappingEvidence[]
  phiReport      PhiReport?

  @@index([documentId])
  @@map("document_versions")
}

model PhiReport {
  id                String          @id @default(uuid())
  documentVersionId String          @unique @map("document_version_id")
  hasPHI            Boolean         @default(false) @map("has_phi")
  detectedEntities  Json?           @map("detected_entities")
  scannerVersion    String?         @default("v2") @map("scanner_version")
  scannedAt         DateTime        @default(now()) @map("scanned_at")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@map("phi_reports")
}

model MappingEvidence {
  id                String          @id @default(uuid())
  documentVersionId String          @map("document_version_id")
  standardId        String          @map("standard_id")
  snippet           String
  justification     String?
  status            String          @default("pending")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([documentVersionId])
  @@map("mapping_evidence")
}
