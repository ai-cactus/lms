// ── Email Delivery Tracking ──────────────────────────────────────────────────

/// Delivery-tracking record for a single outbound email. Written when an email
/// is queued and updated as delivery is attempted (status/attempts/lastError).
/// `reminderLogId`, `reminderNudgeId` and `organizationId` are plain,
/// unconstrained references — kept decoupled (no relation/FK) so email delivery
/// is independent of the reminder and tenancy data it describes, and the
/// delivery trail survives deletion of the rows it points at.
///
/// `status` is `queued` → `sent` | `failed`; a `failed` row the retry pass will
/// not re-send because its enrolment was since finished, superseded or archived
/// is retired as `cancelled` (BUG-45).
///
/// A per-reminder send points at the row it was claimed under — `reminderLogId`
/// for a ladder stage, `reminderNudgeId` for a Track B nudge (BUG-22) — which is
/// what the sweep's retry pre-pass rebuilds a failed send from.
///
/// Both stay null for the `cycle_summary` kind: a summary email covers many
/// reminder rows at once, so a single-row pointer cannot express its contents. The rows it captured are enumerated by
/// {@link CycleSummaryItem} instead.
model EmailMessage {
  id              String             @id @default(uuid())
  toEmail         String             @map("to_email")
  /// Recipient display name, when the sender knew one.
  toName          String?            @map("to_name")
  kind            String
  /// Owning organization, for per-tenant delivery reporting. Unconstrained.
  organizationId  String?            @map("organization_id")
  reminderLogId   String?            @map("reminder_log_id")
  reminderNudgeId String?            @map("reminder_nudge_id")
  status          String             @default("queued")
  attempts        Int                @default(0)
  maxAttempts     Int                @default(3) @map("max_attempts")
  lastError       String?            @map("last_error")
  sentAt          DateTime?          @map("sent_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  cycleSummary    CycleSummaryItem[]

  @@index([status, attempts])
  @@map("email_messages")
}

/// One source row captured into a cycle-summary email. Makes a summary's
/// contents auditable ("which reminders did this email actually carry?") and,
/// with the unique constraint, makes the compose pass idempotent: a retried
/// transaction re-inserts the same rows and `skipDuplicates` absorbs them.
///
/// `itemType` is one of `reminder_log` | `reminder_nudge` | `notification_event`
/// and `itemId` is that row's id — deliberately unconstrained (the source row
/// may be purged independently), while the EmailMessage side is a real FK so
/// retention purging an email takes its item rows with it.
///
/// `recipientRole` is the audience a reminder line was written for — `worker`
/// or `escalation` — and is part of the key (BUG-21): a self-escalating admin's
/// own overdue course is legitimately ONE row carried TWICE by one email (under
/// "Your training" and under "Team & compliance"), and a key without the role
/// collapsed the two, so a retry could only rebuild one. `''` for a
/// notification event, and for rows recorded before the column existed, whose
/// role the retry still infers from the recipient's address.
model CycleSummaryItem {
  id             String       @id @default(uuid())
  emailMessageId String       @map("email_message_id")
  itemType       String       @map("item_type")
  itemId         String       @map("item_id")
  recipientRole  String       @default("") @map("recipient_role")
  createdAt      DateTime     @default(now()) @map("created_at")
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@unique([emailMessageId, itemType, itemId, recipientRole])
  @@index([emailMessageId])
  @@map("cycle_summary_items")
}
