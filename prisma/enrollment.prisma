// ── Enrollment & Certificates ───────────────────────────────────────────────

enum EnrollmentStatus {
  enrolled
  assigned
  in_progress
  lessons_complete
  completed
  attested
  locked
  failed
  retry_requested
}

enum ReminderStage {
  INITIAL_LAUNCH
  FRIENDLY_REMINDER
  URGENT_REMINDER
  DAY_OF_DEADLINE
  GRACE_SOFT_ESCALATION
  HARD_ESCALATION
  ADMIN_PRE_DEADLINE_REMINDER
}

enum ReminderNudgeKind {
  WORKER_RETAKE
  ADMIN_REASSIGN
}

/// F-053: at most one *active* enrollment may exist per
/// (organization_user_id, course_id).
/// "Active" = the in-flight statuses enrolled | assigned | in_progress |
/// lessons_complete. Terminal/historical statuses (completed, attested, locked,
/// failed, retry_requested) are excluded so retakes — which create a new
/// enrollment while the prior one stays completed/failed — remain valid.
/// This is enforced by a PARTIAL unique index
/// (`enrollments_org_user_id_course_id_active_key ... WHERE status IN (...)`),
/// rekeyed onto organization_user_id in the multi-org migration. Prisma cannot express a
/// partial/filtered unique, so it exists only at the DB level (no `@@unique` here).
model Enrollment {
  id                   String            @id @default(uuid())
  organizationUserId   String            @map("organization_user_id")
  courseId             String            @map("course_id")
  /// Facility the learner belonged to when the enrollment was created. Denormalised
  /// so facility-scoped dashboards can aggregate without walking the membership's
  /// (mutable) facility assignments — a later transfer must not rewrite history.
  /// Null when the member has no active facility row.
  facilityId           String?           @map("facility_id")
  status               EnrollmentStatus  @default(enrolled)
  progress             Int               @default(0)
  videoPositionSeconds Int?              @map("video_position_seconds")
  score                Int?
  startedAt            DateTime          @default(now()) @map("started_at")
  /// The instant this enrollment reached a terminal COMPLETED state — which in
  /// this product is the moment the learner SIGNED THE ATTESTATION, not the
  /// moment they passed the assessment. The two can be days apart, and they are
  /// deliberately not conflated: passing the quiz leaves the enrollment
  /// `in_progress` (see the quiz submit route), and only `completed | attested`
  /// rows are counted as completed by the auditor exports, the facility
  /// dashboards and the renewal sweep — so a date stamped at quiz-pass would
  /// put a completion date on rows those same readers report as unfinished.
  /// The assessment-pass moment is separately recorded on the passing
  /// `QuizAttempt.completedAt`.
  /// Written by `attestCourse` in lockstep with `attestedAt` (one Date, both
  /// columns) and cleared in lockstep by `retakeQuiz`. Rows carrying the legacy
  /// `completed` status predate attestation and have no `attestedAt`; their
  /// value was reconstructed by the `backfill_enrollment_completed_at`
  /// migration, which documents the sources it derived from.
  completedAt          DateTime?         @map("completed_at")
  attestedAt           DateTime?         @map("attested_at")
  attestationSignature String?           @map("attestation_signature")
  attestationRole      String?           @map("attestation_role")
  assignedByAdminId    String?           @map("assigned_by_admin_id")
  lockedAt             DateTime?         @map("locked_at")
  retakeOf             String?           @map("retake_of")
  retakeReason         String?           @map("retake_reason")
  renewedFrom          String?           @map("renewed_from")
  assignmentId         String?           @map("assignment_id")
  accessAt             DateTime?         @map("access_at")
  dueAt                DateTime?         @map("due_at")
  assignment           CourseAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  course               Course            @relation(fields: [courseId], references: [id])
  organizationUser     OrganizationUser  @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  facility             Facility?         @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  quizAttempts         QuizAttempt[]
  certificate          Certificate?
  reminderLogs         ReminderLog[]
  reminderNudges       ReminderNudge[]

  @@index([organizationUserId, courseId])
  @@index([courseId])
  @@index([facilityId])
  @@index([facilityId, status])
  @@index([completedAt])
  @@index([assignmentId])
  @@index([status, dueAt])
  @@index([courseId, status, completedAt])
  @@map("enrollments")
}

model Certificate {
  id                 String           @id @default(uuid())
  enrollmentId       String           @unique @map("enrollment_id")
  organizationUserId String           @map("organization_user_id")
  courseId           String           @map("course_id")
  issuedAt           DateTime         @default(now()) @map("issued_at")
  score              Int
  pdfStoragePath     String?          @map("pdf_storage_path")
  pdfGeneratedAt     DateTime?        @map("pdf_generated_at")
  organizationUser   OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  enrollment         Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([organizationUserId])
  @@index([courseId])
  @@map("certificates")
}

model ReminderLog {
  id           String        @id @default(uuid())
  enrollmentId String        @map("enrollment_id")
  stage        ReminderStage
  channels     String[]      @default([])
  targetDate   DateTime      @map("target_date")
  sentAt       DateTime      @default(now()) @map("sent_at")
  /// When this row stopped being eligible for a cycle summary — either because
  /// the compose pass captured it into a recipient's daily email, or because
  /// dispatch already delivered it as its own per-stage email (the pre-cutover
  /// path, still live while CYCLE_SUMMARY_ENABLED is off). Null = still awaiting
  /// a summary. Stamping the flag-off path is what stops a later flag flip from
  /// re-sending, inside a summary, reminders that were already emailed.
  /// Scanned via a partial index (`WHERE summarized_at IS NULL`) that Prisma's
  /// DSL cannot express, so it is hand-maintained in SQL — see the
  /// add_cycle_summary migration.
  summarizedAt DateTime?     @map("summarized_at")
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, stage])
  @@index([enrollmentId])
  @@map("reminder_logs")
}

model ReminderNudge {
  id                String            @id @default(uuid())
  enrollmentId      String            @map("enrollment_id")
  kind              ReminderNudgeKind
  lastSentAt        DateTime          @default(now()) @map("last_sent_at")
  count             Int               @default(1)
  /// See ReminderLog.summarizedAt. A nudge row is upserted rather than inserted,
  /// so every re-nudge must REWRITE this on both upsert branches — null while
  /// CYCLE_SUMMARY_ENABLED is on, stamped while it is off. A value left over
  /// from a previous cycle would hide the second and later nudges for an
  /// enrollment from every future summary.
  summarizedAt      DateTime?         @map("summarized_at")
  /// Quiz attempts the worker had left when this nudge was claimed
  /// (`WORKER_RETAKE` only; null for `ADMIN_REASSIGN`, which fires once they are
  /// exhausted). The count is computed by the sweep from the latest attempt, and
  /// the cycle summary composes hours later — so it is pinned here rather than
  /// recomputed, and re-pinned on every re-nudge alongside `summarizedAt`.
  attemptsRemaining Int?              @map("attempts_remaining")
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, kind])
  @@index([enrollmentId])
  @@map("reminder_nudges")
}

/// Pending course assignments attached to an outstanding staff Invite. When a
/// course is assigned to an unknown (or org-less) email, no user/enrollment is
/// created yet — the course is parked here and materialised into a real
/// enrollment when the invite is accepted (see enrollInviteCourses). Only the
/// courseId is stored; schedule/deadline settings are resolved at accept time
/// from the org's CourseAssignment row, mirroring role-target auto-enroll.
/// Revoking the invite cascades these rows away.
model InviteCourseAssignment {
  id        String   @id @default(uuid())
  inviteId  String   @map("invite_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([inviteId, courseId])
  @@index([courseId])
  @@map("invite_course_assignments")
}
