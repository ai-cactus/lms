// ── Organization & Billing ───────────────────────────────────────────────────

enum SubscriptionPlan {
  starter
  growth
  pro
  enterprise
}

enum SubscriptionBillingCycle {
  monthly
  quarterly
  yearly
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

model Organization {
  id                          String                           @id @default(uuid())
  name                        String
  slug                        String                           @unique
  dba                         String?
  ein                         String?
  primaryContact              String?                          @map("primary_contact")
  primaryEmail                String?                          @map("primary_email")
  isHipaaCompliant            Boolean                          @default(false) @map("is_hipaa_compliant")
  hasAuditorAccess            Boolean                          @default(false) @map("has_auditor_access")
  primaryBusinessType         String?                          @map("primary_business_type")
  additionalBusinessTypes     String[]                         @default([]) @map("additional_business_types")
  joinCode                    String?                          @unique @map("join_code")
  joinCodeExpiresAt           DateTime?                        @map("join_code_expires_at")
  stripeCustomerId            String?                          @unique @map("stripe_customer_id")
  inactivityTimeoutMinutes    Int                              @default(15) @map("inactivity_timeout_minutes")
  requireMfa                  Boolean                          @default(false) @map("require_mfa")
  // How often batched (Tier 2) notifications are emailed. Per-type opt-outs
  // stay per-user on NotificationPreference; this is the org-wide cadence.
  notificationDigestFrequency DigestFrequency                  @default(daily) @map("notification_digest_frequency")
  // Org-wide per-category delivery switches (email / in-app).
  notificationCategoryPrefs   NotificationCategoryPreference[]
  organizationUsers           OrganizationUser[]
  facilities                  Facility[]
  createdAt                   DateTime                         @default(now()) @map("created_at")
  updatedAt                   DateTime                         @updatedAt @map("updated_at")
  invites                     Invite[]
  subscription                Subscription?
  invoices                    Invoice[]
  customCategories            CourseCategory[]
  documentCategories          DocumentCategory[]
  offerings                   OrgCourseOffering[]
  courseAssignments           CourseAssignment[]

  @@map("organizations")
}

model Facility {
  id                     String                     @id @default(uuid())
  organizationId         String                     @map("organization_id")
  name                   String
  type                   String?
  address                String?
  city                   String?
  state                  String?
  country                String?
  zipCode                String?                    @map("zip_code")
  phone                  String?
  licenseNumber          String?                    @map("license_number")
  staffCount             String?                    @map("staff_count")
  programServices        String[]                   @default([]) @map("program_services")
  complianceDocumentUrl  String?                    @map("compliance_document_url")
  complianceDocumentName String?                    @map("compliance_document_name")
  timezone               String?                    @map("timezone")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userFacilities         OrganizationUserFacility[]
  documents              FacilityDocument[]
  invites                Invite[]
  enrollments            Enrollment[]

  @@index([organizationId])
  @@map("facilities")
}

/// One row per (user, organization) membership — the seam that lets a single
/// identity belong to multiple organizations, each with its own role, facility
/// assignments, and login history. Replaces
/// User.organizationId/role/roleAssignedAt/managerId/lastLoginAt. All org-scoped
/// domain artifacts (courses authored, documents uploaded, enrollments,
/// certificates, notifications) hang off this row, not User.
model OrganizationUser {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String    @map("organization_id")
  role           UserRole
  jobTitle       String?   @map("job_title")
  // Org-wide revocation (HR/Owner-initiated). Distinct from per-facility
  // revocation on OrganizationUserFacility.active.
  active         Boolean   @default(true)
  managerId      String?   @map("manager_id")
  joinedAt       DateTime  @default(now()) @map("joined_at")
  roleAssignedAt DateTime  @default(now()) @map("role_assigned_at")
  deactivatedAt  DateTime? @map("deactivated_at")
  // Last login INTO THIS org context (replaces the single global User.lastLoginAt).
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      OrganizationUser?          @relation("OrgUserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      OrganizationUser[]         @relation("OrgUserManager")
  facilities   OrganizationUserFacility[]

  createdCourses    Course[]                 @relation("CourseCreator")
  approvedCourses   Course[]                 @relation("CourseApprover")
  documents         Document[]
  enrollments       Enrollment[]
  certificates      Certificate[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([organizationId, active])
  @@index([managerId])
  @@map("organization_users")
}

/// A membership's facility assignments. Supervisors accumulate multiple active
/// rows (permitted facilities); workers typically have one. `active = false`
/// revokes access to that single facility without touching the parent
/// OrganizationUser or its other facility rows.
model OrganizationUserFacility {
  id                 String    @id @default(uuid())
  organizationUserId String    @map("organization_user_id")
  facilityId         String    @map("facility_id")
  active             Boolean   @default(true)
  joinedAt           DateTime  @default(now()) @map("joined_at")
  deactivatedAt      DateTime? @map("deactivated_at")

  organizationUser OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([organizationUserId, facilityId])
  @@index([facilityId])
  @@map("organization_user_facilities")
}

model FacilityDocument {
  id           String   @id @default(uuid())
  facilityId   String   @map("facility_id")
  url          String
  name         String
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("facility_documents")
}

model Subscription {
  id                    String                    @id @default(uuid())
  organizationId        String                    @unique @map("organization_id")
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeSubscriptionId  String                    @unique @map("stripe_subscription_id")
  stripePriceId         String                    @map("stripe_price_id")
  plan                  SubscriptionPlan
  billingCycle          SubscriptionBillingCycle  @map("billing_cycle")
  status                SubscriptionStatus
  currentPeriodStart    DateTime                  @map("current_period_start")
  currentPeriodEnd      DateTime                  @map("current_period_end")
  cancelAtPeriodEnd     Boolean                   @default(false) @map("cancel_at_period_end")
  // Set while billing is paused via Stripe `pause_collection`. Stripe keeps the
  // status as `active` when paused, so this is what gates access while paused.
  pausedAt              DateTime?                 @map("paused_at")
  // When the pause window ends (pausedAt + chosen months, max 3). Once reached,
  // the admin is prompted to either continue (resume) or cancel the plan.
  pauseEndsAt           DateTime?                 @map("pause_ends_at")
  // Pending future plan change that takes effect at currentPeriodEnd (null = no
  // pending change). plan/billingCycle/stripePriceId keep representing what is
  // LIVE NOW; these scheduled* columns represent the queued replacement backed
  // by a Stripe subscription schedule.
  scheduledPlan         SubscriptionPlan?         @map("scheduled_plan")
  scheduledBillingCycle SubscriptionBillingCycle? @map("scheduled_billing_cycle")
  scheduledPriceId      String?                   @map("scheduled_price_id")
  scheduledEffectiveAt  DateTime?                 @map("scheduled_effective_at")
  stripeScheduleId      String?                   @unique @map("stripe_schedule_id")
  // Active Stripe discount on this subscription (null when none). Populated by
  // the subscription webhook; promo code text falls back to coupon name when
  // applied from the dashboard without a promotion code.
  discountPromoCode     String?                   @map("discount_promo_code")
  discountCouponName    String?                   @map("discount_coupon_name")
  discountPercentOff    Float?                    @map("discount_percent_off")
  discountAmountOff     Int?                      @map("discount_amount_off") // minor units
  discountCurrency      String?                   @map("discount_currency")
  discountDuration      String?                   @map("discount_duration") // once | repeating | forever
  discountEndsAt        DateTime?                 @map("discount_ends_at") // null for once/forever
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Invoice {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeInvoiceId String       @unique @map("stripe_invoice_id")
  invoiceNumber   String       @map("invoice_number")
  amountPaid      Int          @map("amount_paid")
  currency        String       @default("usd")
  status          String
  invoiceUrl      String?      @map("invoice_url")
  pdfUrl          String?      @map("pdf_url")
  periodStart     DateTime     @map("period_start")
  periodEnd       DateTime     @map("period_end")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("invoices")
}

/// Idempotency ledger for Stripe webhook delivery. Each Stripe event is
/// recorded here on first successful processing; a duplicate delivery of the
/// same `stripeEventId` is rejected by the unique constraint so handlers run
/// at most once. Intentionally decoupled from Subscription/Invoice (no FK).
model ProcessedWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique @map("stripe_event_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}
